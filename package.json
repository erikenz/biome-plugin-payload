{
  "name": "biome-plugin-payload",
  "version": "0.1.3",
  "description": "Biome lint plugin (GritQL) that enforces Payload CMS best practices on Local API calls",
  "keywords": [
    "biome",
    "biome-plugin",
    "gritql",
    "lint",
    "payload",
    "payloadcms",
    "local-api"
  ],
  "homepage": "https://github.com/erikenz/biome-plugin-payload#readme",
  "bugs": {
    "url": "https://github.com/erikenz/biome-plugin-payload/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikenz/biome-plugin-payload.git"
  },
  "license": "MIT",
  "author": {
    "name": "Erik Enz",
    "url": "https://github.com/erikenz"
  },
  "type": "module",
  "files": [
    "rules/*.grit",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write . && bunx sort-package-json",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepublishOnly": "bun test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "payload": "3.87.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.11"
  }
}
